# Sarvam — https://dashboard.sarvam.ai
# One server-local key covers streaming STT, chat extraction, and streaming TTS.
# It is read only by web/serve.ts and never sent to the browser.
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# OpenAI — https://platform.openai.com/api-keys
# Enables the OpenAI option in the in-app voice-provider switcher.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# Optional startup default. The in-app switcher can change this per session.
VOICE_PROVIDER=sarvam

# Optional model overrides.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
