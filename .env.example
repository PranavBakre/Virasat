# Sarvam — https://dashboard.sarvam.ai
# One key covers STT, TTS, and chat. Note the two header conventions:
# speech endpoints use `api-subscription-key`, chat uses `Authorization: Bearer`.
# See docs/sarvam-api.md.
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# Convex — written by `bunx convex dev` on first run, don't set by hand.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# IMPORTANT: Convex actions read the *deployment's* environment, not your shell.
# Set SARVAM_API_KEY in the Convex dashboard as well, or `convex/turn.ts` will
# fail with a 401 that looks like a bad key.
#   bunx convex env set SARVAM_API_KEY sk_xxx
